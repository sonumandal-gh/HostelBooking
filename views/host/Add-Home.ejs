<%- include('../partials/head', { PageTitle, cssFile }) %>

<body>
  <%- include('../partials/nav') %>

  <div class="form-container glass-panel">
    <h1>Add a New Home</h1>
    <form action="/submit-home" method="POST">
        <div class="form-group">
            <label for="homeName">Home Name:</label>
            <input type="text" id="homeName" name="homeName" placeholder="Enter home name" required>
        </div>

        <div class="form-group">
            <label for="address">Address:</label>
            <input type="text" id="address" name="address" placeholder="Enter address" required>
        </div>

        <div class="form-group">
            <label for="city">City:</label>
            <input type="text" id="city" name="city" placeholder="Enter city" required>
        </div>

        <div class="form-group">
            <label for="price">Price (per night):</label>
            <input type="number" id="price" name="price" placeholder="Enter price" required>
        </div>

        <div class="form-group">
            <label for="image">Home Image URL:</label>
            <input type="text" id="image" name="image" placeholder="Enter image URL" required>
        </div>

        <button type="submit" class="btn-primary" style="width: 100%;">Add Home</button>
    </form>
  </div>

</body>  