<%- include('../partials/head', { PageTitle, cssFile }) %>
<body>

<%- include('../partials/nav') %>

<div class="details-container">

  <div class="details-card">

    <!-- IMAGE -->
    <div class="details-image">
      <img 
        src="<%= home.image ? '/uploads/' + home.image : 'https://via.placeholder.com/400x300' %>" 
        alt="<%= home.homeName %>"
      >
    </div>

    <!-- INFO -->
    <div class="details-info">

      <h1>
        <%= home.homeName %> 
        <span class="rating">⭐ <%= home.rating || "4.0" %></span>
      </h1>

      <p class="price">
        ₹<%= home.price %> / month
      </p>

      <!-- INFO BOX -->
      <div class="info-box">

        <p><strong>📍 Address:</strong> <%= home.address %></p>

        <p><strong>🏙 City:</strong> <%= home.city %></p>

        <p>
          <strong>📝 Description:</strong><br>
          <%= home.description || "No description available." %>
        </p>

        <p>
          <strong>✅ Facilities:</strong><br>
          <%= home.facilities || "WiFi, Food, Laundry, Parking" %>
        </p>

        <p>
          <strong>👤 Owner:</strong> 
          <%= home.owner || "Not Provided" %>
        </p>

        <p>
          <strong>📞 Contact:</strong> 
          <% if(home.contact){ %>
            <a href="tel:<%= home.contact %>"><%= home.contact %></a>
          <% } else { %>
            Not Available
          <% } %>
        </p>

      </div>

      <!-- BUTTONS -->
      <div class="btn-group">

        <a href="/hostels" class="btn back">Back</a>

        <form action="/add-to-favourite" method="POST">
          <input type="hidden" name="homeId" value="<%= home._id %>">
          <button type="submit" class="btn fav">
            Add to Favorite
          </button>
        </form>

        <a href="#" class="btn book">Book Now</a>

      </div>

    </div>

  </div>

</div>

</body>
</html>