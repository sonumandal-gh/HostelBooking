<%- include('../partials/head', { PageTitle, cssFile }) %>
<body>
  <%- include('../partials/nav') %>

  <div class="details-container">

    <div class="details-card">
      
      <img 
        src="<%= home.image ? '/uploads/' + home.image : 'https://via.placeholder.com/300x200' %>" 
        alt="<%= home.homeName %>"
      >

      <div class="details-info">
        <h1>
          <%= home.homeName %> 
          ⭐ <%= home.rating || "4.0" %>
        </h1>

        <p class="price">
          ₹<%= home.price %> / month
        </p>

        <p><strong>📍 Address:</strong> 
          <%= home.address %>
        </p>

        <p><strong>🏙 City:</strong> 
          <%= home.city %>
        </p>

        <!-- NEW DETAILS -->
        <p>
          <strong>📝 Description:</strong><br>
          <%= home.description || "No description available for this hostel." %>
        </p>

        <p>
          <strong>✅ Facilities:</strong><br>
          <%= home.facilities || "WiFi, Food, Laundry, Parking" %>
        </p>

        <p>
          <strong>👤 Owner:</strong> 
          <%= home.owner || "Not Provided" %>
        </p>

        <p>
          <strong>📞 Contact:</strong> 
          <% if(home.contact){ %>
            <a href="tel:<%= home.contact %>">
              <%= home.contact %>
            </a>
          <% } else { %>
            Not Available
          <% } %>
        </p>

        <!-- BUTTONS -->
        <div style="margin-top:25px;">
          <a href="/hostels" class="back-btn">
             Back
          </a>

          <form action="/add-to-favourite" method="POST" style="display:inline;">
            <input type="hidden" name="homeId" value="<%= home._id %>">
            <button type="submit" class="favorite-btn">
              Add to Favorite
            </button>
          </form>

          <a href="#" class="book-btn">
            Book Now
          </a>
        </div>

      </div>

    </div>

  </div>
</body>
</html>