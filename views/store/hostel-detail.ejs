<%- include('../partials/head', { PageTitle, cssFile }) %>
<body>
  <%- include('../partials/nav') %>

  <div class="details-container">

    <div class="details-card">
      
      <img 
        src="<%= hostels.image || 'https://via.placeholder.com/600x350' %>"
        alt="<%= hostels.homeName %>"
        class="details-img"
      >

      <div class="details-info">
        <h1>
          <%= hostels.homeName %> 
          ⭐ <%= hostels.rating || "4.0" %>
        </h1>

        <p class="price">
          ₹<%= hostels.price %> / month
        </p>

        <p><strong>📍 Address:</strong> 
          <%= hostels.address %>
        </p>

        <p><strong>🏙 City:</strong> 
          <%= hostels.city %>
        </p>

        <!-- NEW DETAILS -->
        <p>
          <strong>📝 Description:</strong><br>
          <%= hostels.description || "No description available for this hostel." %>
        </p>

        <p>
          <strong>✅ Facilities:</strong><br>
          <%= hostels.facilities || "WiFi, Food, Laundry, Parking" %>
        </p>

        <p>
          <strong>👤 Owner:</strong> 
          <%= hostels.owner || "Not Provided" %>
        </p>

        <p>
          <strong>📞 Contact:</strong> 
          <% if(hostels.contact){ %>
            <a href="tel:<%= hostels.contact %>">
              <%= hostels.contact %>
            </a>
          <% } else { %>
            Not Available
          <% } %>
        </p>

        <!-- BUTTONS -->
        <div style="margin-top:25px;">
          <a href="/hostels" class="back-btn">
             Back
          </a>

          <a href="/Favorites" class="favorite-btn" >Add to Favorite</a>

          <a href="#" class="book-btn">
            Book Now
          </a>
        </div>

      </div>

    </div>

  </div>
</body>
</html>
