<%- include('../partials/head', { PageTitle, cssFile }) %>
<body>

  <%- include('../partials/nav') %>

  <h1 class="page-title">Your Favourite Hostels</h1>

  <div class="hostels-container">

    <% if (!favouriteHomes || favouriteHomes.length === 0) { %>

      <div class="fav-empty">
    
        <img 
          src="https://cdn-icons-png.flaticon.com/512/833/833472.png"
          alt="No favourites"
          class="fav-icon"
        >
    
        <h2>No Favourite Hostels Yet</h2>
    
        <p>You haven't added any hostels to your favourites.</p>
    
        <a href="/hostels" class="browse-btn">
          Browse Hostels
        </a>
    
      </div>
    
    <% } else { %>

      <% favouriteHomes.forEach(home => { %>

        <div class="hostel-card">

          <img 
            src="<%= home.image ? '/uploads/' + home.image : 'https://via.placeholder.com/300x200' %>" 
            alt="<%= home.homeName %>"
          >

          <h3 class="hostel-name">
            <%= home.homeName %>
          </h3>

          <p class="hostel-address">
            <strong>Address:</strong> <%= home.address %>
          </p>

          <p class="hostel-city">
            <strong>City:</strong> <%= home.city %>
          </p>

          <p class="hostel-price">
            <strong>Price:</strong> ₹<%= home.price %>/month
          </p>

          <div class="card-buttons">

            <a href="/hostel-detail/<%= home._id %>" class="details-btn">
              View Details
            </a>

            <a href="/hostel-detail/<%= home._id %>" class="book-now-btn">
              Book Now
            </a>

          </div>

          <form action="/favourites/delete/<%= home._id %>" method="POST">
            <button type="submit" class="delete-btn">
              Remove
            </button>
          </form>

        </div>

      <% }) %>

    <% } %>

  </div>

  <div style="text-align:center; margin-top:20px;">
    <a href="/hostels" class="book-btn">Back to Listings</a>
  </div>

</body>
</html>