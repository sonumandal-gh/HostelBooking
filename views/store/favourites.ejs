<%- include('../partials/head', { PageTitle, cssFile }) %>
<body>

<%- include('../partials/nav') %>

<h1 class="page-title">Your Favourite Hostels</h1>

<div class="hostels-container">

  <% if (!favouriteHomes || favouriteHomes.length === 0) { %>

    <div class="fav-empty">
      <img 
        src="https://cdn-icons-png.flaticon.com/512/833/833472.png"
        alt="No favourites"
        class="fav-icon"
      >
      <h2>No Favourite Hostels Yet</h2>
      <p>You haven't added any hostels to your favourites.</p>
    </div>

  <% } else { %>

    <% favouriteHomes.forEach(home => { %>

      <div class="hostel-card">

        <!-- IMAGE -->
        <div class="card-img">
          <img 
            src="<%= home.image ? '/uploads/' + home.image : 'https://via.placeholder.com/300x200' %>" 
            alt="<%= home.homeName %>"
          >
        </div>

        <!-- INFO -->
        <div class="card-info">

          <h3><%= home.homeName %></h3>

          <p>📍 <%= home.address %></p>
          <p>🏙 <%= home.city %></p>

          <p class="price">
            ₹<%= home.price %> / month
          </p>

        </div>

        <!-- BUTTONS -->
        <div class="card-actions">

          <a href="/hostel-detail/<%= home._id %>" class="btn view">
            View Details
          </a>

          <a href="/hostel-detail/<%= home._id %>" class="btn book">
            Book Now
          </a>

          <form action="/favourites/delete/<%= home._id %>" method="POST">
            <button type="submit" class="btn remove">
              Remove
            </button>
          </form>

        </div>

      </div>

    <% }) %>

  <% } %>

</div>

<div class="back-wrapper">
  <a href="/hostels" class="back-btn">Back to Listings</a>
</div>

</body>
</html>