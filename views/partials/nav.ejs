<nav class="navbar">
  <div class="logo">HostelBooking</div>

  <ul class="nav-links">
    <li><a href="/">Home</a></li>

    <% if(isLoggedIn){ %>

      <!-- Sabko hostels dikhega -->
      <li><a href="/hostels">Hostels</a></li>

      <!-- Guest Links -->
      <% if(user && user.role === 'guest') { %>
        <li><a href="/favourites">Favorite</a></li>
        <li><a href="/Book-Now">Book Now</a></li>
      <% } %>

      <!-- Host Links -->
      <% if(user && user.role === 'host') { %>
        <li><a href="/Add-Home">Add Home</a></li>
      <% } %>

    <% } %>

    <li class="auth-links">

      <% if(!isLoggedIn){ %>
        <a href="/login">Login</a>
        <a href="/signup">SignUp</a>
      <% } else { %>

        <form action="/logout" method="POST" style="display:inline;">
          <button type="submit">Logout</button>
        </form>

      <% } %>

    </li>
  </ul>
</nav>