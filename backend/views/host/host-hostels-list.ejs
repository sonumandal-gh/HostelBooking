<%- include('../partials/head') %>
<body>
  <%- include('../partials/nav') %>

  <h1 class="page-title">
    Your Managed Hostels
  </h1>

  <div class="hostels-container">
    <% if(!homes || homes.length === 0) { %>
      <p style="text-align:center;">No hostels added yet.</p>
    <% } else { %>
      <% homes.forEach((home) => { %>
        <div class="hostel-card">
          <div class="price-tag">₹<%= home.price %>/night</div>
          <img 
            src="<%= home.image || 'https://via.placeholder.com/300x200' %>" 
            alt="<%= home.homeName %>"
          >

          <h3><%= home.homeName %></h3>

          <p><strong>Location:</strong> <%= home.address %>, <%= home.city %></p>

          <div class="card-buttons">
            <a href="/hostel-detail/<%= home._id %>" class="book-btn">View Details</a>
            
            <form action="/host/delete-hostel" method="POST" style="display: inline; width: 100%;">
              <input type="hidden" name="hostelId" value="<%= home._id %>">
              <button type="submit" class="delete-btn">Delete</button>
            </form>
          </div>
        </div>
      <% }) %>
    <% } %>
  </div>
</body>
</html>
