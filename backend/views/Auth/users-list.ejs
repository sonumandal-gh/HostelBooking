<%- include('../partials/head', { PageTitle, cssFile }) %>
<body>
  <%- include('../partials/nav') %>

  <h1 class="page-title">
    Registered Users
  </h1>

  <div class="hostels-container">
    <% if(!users || users.length === 0) { %>
      <p style="text-align:center;">No users registered yet.</p>
    <% } else { %>
      <% users.forEach((userItem) => { %>
        <div class="hostel-card" style="padding: 20px;">
          <div class="user-avatar" style="font-size: 40px; text-align: center; margin-bottom: 10px;">👤</div>
          <h3 style="text-align: center; margin-bottom: 10px;"><%= userItem.fullName %></h3>
          <p><strong>Email:</strong> <%= userItem.email %></p>
          <p><strong>Role:</strong> <span class="status-badge" style="background-color: #4facfe; color: white; padding: 2px 8px; border-radius: 4px; font-size: 12px;"><%= userItem.role %></span></p>
          
          <div class="card-buttons" style="margin-top: 15px;">
            <a href="mailto:<%= userItem.email %>" class="book-btn" style="text-align: center;">Contact User</a>
          </div>
        </div>
      <% }) %>
    <% } %>
  </div>
</body>
</html>
